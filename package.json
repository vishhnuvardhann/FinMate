{
  "name": "finmate",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "electron-main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:web": "vite build",
    "electron": "electron .",
    "build:desktop": "npm run build:web && electron-builder"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/cli": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "astral-regex": "^2.0.0",
    "firebase": "^12.6.0",
    "jspdf": "^3.0.4",
    "jspdf-autotable": "^5.0.2",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-router-dom": "^7.10.1",
    "recharts": "^3.5.1"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^39.2.6",
    "electron-builder": "^24.13.3",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  },
  "build": {
    "appId": "com.finmate.app",
    "productName": "FinMate",
    "directories": {
      "output": "build"
    },
    "files": [
      "dist/**/*",
      "electron-main.cjs",
      "preload.js"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/logo/finmate-logo.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "public/logo/finmate-logo.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "public/logo/finmate-logo.png"
    }
  }
}
